# Required — Supabase powers map spots & species data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional BFF proxy for weather/tides/spots.
# EXPO_PUBLIC_BFF_URL=https://your-bff.example.com

# Cloud sync rollout flag. When "true", signed-in users get account UI,
# per-user catch backup (RLS-protected catch_logs), photo backup, and the
# opt-in anonymous community contribution toggle. Signed-out users always
# stay local-only regardless of this flag.
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=true

# AI species identification and Catch AI (Pro — hosted on CatchMap servers).
EXPO_PUBLIC_ENABLE_SPECIES_ID=true
# Catch AI chat tab (default on). Usage requires CatchMap Pro.
# EXPO_PUBLIC_ENABLE_CATCH_AI_CHAT=true
# EXPO_PUBLIC_ENABLE_CATCH_AI_COACH=true

# CatchMap Pro monetization (default on). Set false to disable Pro gating during rollback.
# EXPO_PUBLIC_ENABLE_PRO=true
# Dev only: unlock all Pro features without a purchase
# EXPO_PUBLIC_PRO_DEV_UNLOCK=true

# RevenueCat API keys (iOS + Android) — required for in-app purchases
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Structured Catch Coach — rig/technique suggestions from catalog, bite scores, and catch history.
EXPO_PUBLIC_ENABLE_CATCH_COACH=true

# Personal bite fingerprint — learns your conditions patterns from catch history (default on).
# EXPO_PUBLIC_ENABLE_PERSONAL_BITE=true

# Required for Play Store — host legal pages and paste URLs here.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-project.supabase.co/functions/v1/privacy-policy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://your-project.supabase.co/functions/v1/terms-of-service

# Optional crash reporting (Sentry). Create a React Native project and paste the DSN.
# Reporting stays disabled until this is set. Also set SENTRY_AUTH_TOKEN as an EAS secret
# if you want source maps uploaded during production builds.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional feedback email fallback when Supabase RPC is unavailable.
# EXPO_PUBLIC_FEEDBACK_EMAIL=support@catchmap.app
